# Percent-encode special characters in the password (for example, @ becomes %40).
# Local development may use the direct URL. For Vercel, use the Supavisor
# transaction-pooler URL from Supabase Connect (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=1
SESSION_SECRET=generate-at-least-32-random-bytes

# Used only when the admins table is empty.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
